{
  "name": "oxvgui",
  "private": true,
  "version": "0.2.11",
  "license": "MIT",
  "repository": "github:jonasgeiler/oxvgui",
  "author": "Jonas Geiler",
  "contributors": [
    "XhmikosR <xhmikosr@gmail.com>",
    "Jake Archibald"
  ],
  "scripts": {
    "prepare": "test -d .git && git config core.hooksPath .githooks || true",
    "dev": "gulp dev",
    "start": "pnpm run dev",
    "check": "pnpm run '/^check:.*/'",
    "check:cargo": "cargo fmt --check",
    "check:biome": "biome check",
    "check:stylelint": "stylelint src/css/",
    "fix": "cargo fmt && biome check --fix && stylelint --fix src/css/",
    "unsafe-fix": "biome check --unsafe --fix",
    "build": "gulp build",
    "preview": "live-server --verbose --no-browser --wait=15000 build",
    "size": "size-limit",
    "preversion": "node --eval='const f=`src/changelog.yaml`,v=process.env.npm_new_version;if(!require(`fs`).readFileSync(f,`utf8`).includes(v)){console.error(`No entry in ${f} for version ${v}\\n`);process.exit(1)}'"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@size-limit/file": "13.0.3",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@types/clean-css": "4.2.11",
    "@types/gulp": "4.0.18",
    "@types/gulp-htmlmin": "1.3.36",
    "@types/gulp-if": "3.0.5",
    "@types/gulp-sass": "6.0.0",
    "@types/live-server": "1.2.3",
    "@types/node": "26.2.0",
    "@types/prismjs": "1.26.6",
    "@types/vinyl-source-stream": "0.0.34",
    "clean-css": "5.3.3",
    "gulp": "5.0.1",
    "gulp-htmlmin": "5.0.1",
    "gulp-if": "3.0.0",
    "gulp-nunjucks": "6.1.0",
    "gulp-sass": "6.0.1",
    "live-server": "1.2.2",
    "nanoevents": "10.0.0",
    "pako": "3.0.1",
    "prismjs": "1.30.0",
    "rollup": "4.62.4",
    "sass": "1.102.0",
    "size-limit": "13.0.3",
    "smol-toml": "1.8.0",
    "stylelint": "17.14.1",
    "stylelint-config-twbs-bootstrap": "16.1.0",
    "vinyl-map": "1.0.2",
    "vinyl-source-stream": "2.0.0",
    "wasm-pack": "0.15.0",
    "yaml": "2.9.0"
  },
  "size-limit": [
    {
      "path": "build/sw.js",
      "limit": "1 kB"
    },
    {
      "path": "build/js/page.js",
      "limit": "8 kB"
    },
    {
      "path": "build/js/gzip-worker.js",
      "limit": "9 kB"
    },
    {
      "path": "build/js/prism-worker.js",
      "limit": "7 kB"
    },
    {
      "path": "build/js/oxvg-worker.js",
      "limit": "132 kB"
    }
  ]
}
